# Copy to .env and fill in. .env is gitignored. Never commit real values.

# --- Model (pick one; all have a $0 option) --------------------------------
LLM_PROVIDER=mock               # mock | gemini | groq | ollama
# LLM_MODEL=                    # optional override (defaults: gemini-3.8-flash, openai/gpt-oss-120b, qwen2.5-coder:7b)
# LLM_FALLBACK_MODELS=          # tried in order if the main model is overloaded/retired (default gemini: gemini-3.6-flash,gemini-3.5-flash-lite; 'none' disables)
GEMINI_API_KEY=                 # free key: https://aistudio.google.com/apikey
GROQ_API_KEY=                   # free key: https://console.groq.com
OLLAMA_URL=http://localhost:11434
LLM_PRICE_IN_PER_MTOK=0         # USD per 1M input tokens (0 on free tiers), used for the live cost meter
LLM_PRICE_OUT_PER_MTOK=0

# --- GitHub (live mode only) ------------------------------------------------
GITHUB_TOKEN=                   # fine-grained PAT scoped to ONE sandbox repo (see README)
GITHUB_REPO=                    # owner/name of that sandbox repo
WEBHOOK_SECRET=                 # any long random string; same value in the GitHub webhook settings

# --- Sandbox ----------------------------------------------------------------
SANDBOX=docker                  # live runs always use docker (local is refused outside mock mode)
MOCK_SANDBOX=local              # mock runs execute our own fixture code: local is fine, docker also works
SANDBOX_IMAGE=fr-sandbox:latest
SANDBOX_TIMEOUT_S=180

# --- Per-run budgets (hard limits) -----------------------------------------
MAX_TOOL_CALLS=40
MAX_LLM_CALLS=6
MAX_RUN_SECONDS=420
MAX_COST_USD=0.50
MAX_COMMENTS=10

# --- Mock mode ---------------------------------------------------------------
MOCK_DELAY_S=0.6                # simulated API latency in the dashboard so runs are watchable
